# Motius — copy to .env, here at the root, for local settings. One file for
# both halves: the API reads it on start, and the web app reads the VITE_ ones.
# Every value here is the default. Never commit .env: it is ignored by git.

# ---- The API --------------------------------------------------------------

# Port the HTTP server binds to.
PORT=5175

# Interface to bind. 0.0.0.0 exposes the API to your LAN, which is what you want
# when testing the app on a phone or tablet against a dev machine.
HOST=0.0.0.0

# development | test | production
NODE_ENV=development

# SQLite file. Relative paths resolve against the api workspace (apps/api).
DATABASE_PATH=./data/motius.sqlite

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Sign in with Google: the client ID of a Google OAuth client (type: Web
# application) whose Authorized JavaScript origins include the app's address
# (http://localhost:5174 here, the real domain in production). Only the client
# ID is needed, never the secret. Empty: the sign-in page says sign-in is not set up.
GOOGLE_CLIENT_ID=

# Comma-separated Google addresses that are admins: they get the Lesson settings
# page and may change how lessons open and which shelf a song is on.
ADMIN_EMAILS=

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# Limits. The defaults suit every install; change one only with a reason.
# The largest request body, in bytes (64 KB).
# BODY_LIMIT_BYTES=65536
# The largest body of POST /runs, which can carry a device's runs from before
# sign-in all at once, in bytes (4 MB).
# RUNS_BODY_LIMIT_BYTES=4194304
# How long fetching Google's sign-in keys may take, in milliseconds.
# GOOGLE_TIMEOUT_MS=5000
# How long a shutdown waits for requests to finish before the process exits,
# in milliseconds.
# SHUTDOWN_TIMEOUT_MS=5000

# ---- The web app ----------------------------------------------------------

# Base URL for the Motius API. Leave unset in development — Vite proxies /api
# to the API server, so the browser only ever sees one origin.
# VITE_API_BASE_URL=https://api.motius.app/api/v1

# Where `npm run dev` proxies /api to.
# VITE_API_PROXY_TARGET=http://localhost:5175
